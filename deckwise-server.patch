diff --git a/DocService/sources/deckwiseEditorAccess.js b/DocService/sources/deckwiseEditorAccess.js
new file mode 100644
index 0000000..813618c
--- /dev/null
+++ b/DocService/sources/deckwiseEditorAccess.js
@@ -0,0 +1,72 @@
+'use strict';
+
+const writeMessages = new Set(['getLock', 'isSaveLock', 'saveChanges', 'unLockDocument', 'unSaveLock', 'forceSaveStart']);
+const writeRpcMessages = new Set(['sendForm', 'saveRelativeFromChanges', 'wopi_RenameFile', 'wopi_RefreshFile', 'deckwiseTeachingTts']);
+const guardedMessages = new Set([...writeMessages, 'openDocument', 'rpc']);
+const managedClientId = /^tenant-[1-9][0-9]{0,18}-user-[1-9][0-9]{0,18}-client-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/u;
+
+function isWriteMessage(data, user) {
+  return writeMessages.has(data.type) ||
+    (data.type === 'rpc' && writeRpcMessages.has(data.data?.type)) ||
+    !user.view;
+}
+
+function isManagedClientUserId(userId) {
+  return managedClientId.test(userId || '');
+}
+
+function createEditorAccess(endpoint, secret, request = fetch) {
+  if (!endpoint && !secret) return null;
+  if (!endpoint || !secret) throw new Error('Incomplete DeckWise editor access configuration');
+  const url = new URL(endpoint);
+  if (url.protocol !== 'https:' && !(url.protocol === 'http:' && ['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname))) {
+    throw new Error('DeckWise editor access requires HTTPS or loopback HTTP');
+  }
+  if (url.username || url.password || url.search || url.hash || !secret || Buffer.byteLength(secret) < 32 || /[\r\n]/u.test(secret)) {
+    throw new Error('Invalid DeckWise editor access configuration');
+  }
+  const check = async (documentKey, docsUserId, edit) => {
+    const target = new URL(url);
+    target.search = new URLSearchParams({documentKey, docsUserId, edit});
+    try {
+      const response = await request(target, {
+        method: 'POST',
+        headers: {'X-DeckWise-Docs-Access': secret},
+        redirect: 'error',
+        signal: AbortSignal.timeout(2000)
+      });
+      try { await response.body?.cancel(); } catch { /* The access decision depends on the response status only. */ }
+      if (response.status === 204) return 'allowed';
+      if (response.status === 403) return 'denied';
+    } catch {
+      // The caller distinguishes a revoked mount from an unavailable Platform.
+    }
+    return 'unavailable';
+  };
+  check.tts = async (documentKey, docsUserId, command) => {
+    if (!command || !['models', 'quote', 'submit'].includes(command.operation))
+      return {code: 46001, message: 'INVALID_REQUEST'};
+    const body = JSON.stringify(command);
+    if (Buffer.byteLength(body) > 32768) return {code: 46001, message: 'INVALID_REQUEST'};
+    const target = new URL('editor-tts', url);
+    target.search = new URLSearchParams({documentKey, docsUserId});
+    const response = await request(target, {
+      method: 'POST',
+      headers: {'X-DeckWise-Docs-Access': secret, 'Content-Type': 'application/json'},
+      redirect: 'error',
+      signal: AbortSignal.timeout(185000),
+      body
+    });
+    if (!response.ok) {
+      try { await response.body?.cancel(); } catch { /* The status already determines the outcome. */ }
+      if (response.status >= 500 && command.operation === 'submit') {
+        return {code: 46016, message: 'UPSTREAM_OUTCOME_UNKNOWN'};
+      }
+      return {code: 46000, message: response.status === 403 ? 'AUTH_REQUIRED' : 'ONLINE_TTS_UNAVAILABLE'};
+    }
+    return response.json();
+  };
+  return check;
+}
+
+module.exports = {createEditorAccess, guardedMessages, isManagedClientUserId, isWriteMessage};
diff --git a/tests/unit/deckwiseEditorAccess.tests.js b/tests/unit/deckwiseEditorAccess.tests.js
new file mode 100644
index 0000000..7b2316b
--- /dev/null
+++ b/tests/unit/deckwiseEditorAccess.tests.js
@@ -0,0 +1,51 @@
+'use strict';
+
+const {describe, it, expect} = require('@jest/globals');
+const {createEditorAccess, guardedMessages, isManagedClientUserId, isWriteMessage} = require('../../DocService/sources/deckwiseEditorAccess');
+
+describe('DeckWise registered editor access', () => {
+  const secret = 'a-local-test-secret-with-more-than-thirty-two-bytes';
+  const identity = ['courseware-key', 'tenant-1-user-2-client-11111111-1111-4111-8111-111111111111', true];
+
+  it('requires a trusted endpoint and strong shared secret', () => {
+    for (const [url, key] of [
+      ['http://docs.example/access', secret],
+      ['http://127.0.0.1/access', 'short'],
+      ['https://docs.example/access?redirect=unsafe', secret],
+      ['https://user:pass@docs.example/access', secret],
+      ['https://docs.example/access', secret + '\nInjected: true'],
+    ]) expect(() => createEditorAccess(url, key)).toThrow();
+    expect(createEditorAccess(undefined, undefined)).toBeNull();
+    expect(isManagedClientUserId(identity[1])).toBe(true);
+    expect(isManagedClientUserId('ordinary-user-id')).toBe(false);
+  });
+
+  it('allows the exact registered request, denies revoked mounts and fails closed on outages', async () => {
+    const calls = [];
+    const access = createEditorAccess('https://platform.example/courseware/document-server/editor-access', secret,
+      async (url, options) => {
+        calls.push({url, options});
+        return {status: calls.length === 1 ? 204 : calls.length === 2 ? 403 : 503, body: null};
+      });
+    expect(await access(...identity)).toBe('allowed');
+    expect(await access(...identity)).toBe('denied');
+    expect(await access(...identity)).toBe('unavailable');
+    expect(calls[0].url.searchParams.get('documentKey')).toBe(identity[0]);
+    expect(calls[0].url.searchParams.get('docsUserId')).toBe(identity[1]);
+    expect(calls[0].options.headers['X-DeckWise-Docs-Access']).toBe(secret);
+    expect(calls[0].options.redirect).toBe('error');
+  });
+
+  it('keeps every protocol path that can expose or change a document behind admission', () => {
+    for (const type of ['openDocument', 'getLock', 'isSaveLock', 'saveChanges', 'unLockDocument', 'unSaveLock', 'forceSaveStart', 'rpc']) {
+      expect(guardedMessages.has(type)).toBe(true);
+    }
+    expect(isWriteMessage({type: 'openDocument'}, {view: true})).toBe(false);
+    expect(isWriteMessage({type: 'saveChanges'}, {view: true})).toBe(true);
+    expect(isWriteMessage({type: 'unSaveLock'}, {view: true})).toBe(true);
+    for (const type of ['sendForm', 'saveRelativeFromChanges', 'wopi_RenameFile', 'wopi_RefreshFile']) {
+      expect(isWriteMessage({type: 'rpc', data: {type}}, {view: true})).toBe(true);
+    }
+    expect(isWriteMessage({type: 'rpc', data: {type: 'pathurls'}}, {view: true})).toBe(false);
+  });
+});
